---
import '../styles/global.css';
const {title,description, image='/assets/photography/ville-outdoor.jpg',noindex=false} = Astro.props;
const path=Astro.url.pathname;
const canonical=new URL(path,Astro.site);
const nav=[['Experience','/experience/'],['About','/about/']];
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#F5F1EA"/><title>{title} | ARONIA</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:type" content="website"/><meta property="og:title" content={`${title} | ARONIA`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image,Astro.site)}/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" type="image/png" href="/assets/brand/aronia-a-warm-white-on-copper.png"/>{(noindex || import.meta.env.SITE_RELEASE !== 'production')&&<meta name="robots" content="noindex"/>}<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Organization',name:'ARONIA',legalName:'ARONIA LLC',url:Astro.site,logo:new URL('/assets/brand/aronia-wordmark-charcoal.png',Astro.site),description:'ARONIA helps established European B2B technology companies build and scale their U.S. business.',founder:{'@type':'Person',name:'Ville Houttu'}})}/></head>
<body><a href="#main" class="skip">Skip to content</a><header class="site-header"><div class="wrap nav"><a class="brand" href="/" aria-label="ARONIA home"><img class="brand-mark" src="/assets/brand/aronia-a-warm-white-on-copper.png" width="36" height="36" alt=""/><img class="wordmark" src="/assets/brand/aronia-wordmark-charcoal.png" width="2172" height="360" alt="ARONIA"/></a><nav class="desktop-nav" aria-label="Main navigation"><details class="services-menu"><summary>Services <span aria-hidden="true">⌄</span></summary><div class="services-dropdown"><a href="/foundation-sprint/">Foundation Sprint<span>Choose your starting point</span></a><a href="/market-activation/">Market Activation<span>Put the direction to work</span></a><a href="/fractional-us-growth-advisor/">Fractional U.S. Growth Advisor<span>Lead the next stage</span></a></div></details>{nav.map(([name,url])=><a aria-current={path===url?'page':undefined} href={url}>{name}</a>)}<a class="nav-cta" href="https://calendly.com/aronia/30min" target="_blank" rel="noopener noreferrer">Book an introduction <span aria-hidden="true">↗</span></a></nav><button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span></button></div><nav id="mobile-nav" aria-label="Mobile navigation" hidden><a href="/foundation-sprint/">Foundation Sprint</a>{nav.map(([name,url])=><a href={url}>{name}</a>)}<a href="/market-activation/">Market Activation</a><a href="/fractional-us-growth-advisor/">Fractional Advisor</a><a href="https://calendly.com/aronia/30min" target="_blank" rel="noopener noreferrer">Book an introduction ↗</a></nav></header>
<main id="main"><slot/></main>
<footer><div class="wrap"><div class="footer-top"><div><a class="brand footer-brand" href="/" aria-label="ARONIA home"><img class="brand-mark" src="/assets/brand/aronia-a-warm-white-on-copper.png" width="36" height="36" alt=""/><img class="wordmark" src="/assets/brand/aronia-wordmark-charcoal.png" width="2172" height="360" alt="ARONIA"/></a><p>European roots.<br/><span>U.S. results.</span></p></div><nav aria-label="Footer services"><span class="small-label">Working together</span><a href="/foundation-sprint/">Foundation Sprint</a><a href="/market-activation/">Market Activation</a><a href="/fractional-us-growth-advisor/">Fractional U.S. Growth Advisor</a></nav><nav aria-label="Footer company"><span class="small-label">ARONIA</span><a href="/experience/">Experience</a><a href="/about/">About</a><a href="https://calendly.com/aronia/30min" target="_blank" rel="noopener noreferrer">Contact</a></nav></div><div class="footer-bottom"><a href="/privacy/">Privacy</a><span>© {new Date().getFullYear()} ARONIA LLC</span><span>Focus before scale.</span></div></div></footer>
<script>
const legacy:Record<string,string>={'#foundation':'/foundation-sprint/','#activation':'/market-activation/','#founder':'/about/','#recognition-media':'/about/#recognition-media'}; if(location.pathname==='/' && legacy[location.hash]) location.replace(legacy[location.hash]);
document.querySelectorAll<HTMLElement>('.carousel-track').forEach(track=>{const group=document.createElement('div');group.className='carousel-group';while(track.firstChild)group.appendChild(track.firstChild);track.appendChild(group);const duplicate=group.cloneNode(true) as HTMLElement;duplicate.setAttribute('aria-hidden','true');duplicate.querySelectorAll('img').forEach(img=>img.alt='');track.appendChild(duplicate);track.classList.add('is-animated');const viewport=track.parentElement!;const pause=document.createElement('button');pause.className='carousel-pause';pause.type='button';pause.textContent='Pause animation';pause.setAttribute('aria-pressed','false');pause.addEventListener('click',()=>{const paused=viewport.classList.toggle('is-paused');pause.textContent=paused?'Play animation':'Pause animation';pause.setAttribute('aria-pressed',String(paused));});viewport.after(pause);});
const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle');const panel=document.querySelector<HTMLElement>('#mobile-nav');
function close(){if(!panel||!toggle)return;panel.hidden=true;toggle.setAttribute('aria-expanded','false');toggle.setAttribute('aria-label','Open navigation');}
toggle?.addEventListener('click',()=>{if(!panel)return;const open=toggle.getAttribute('aria-expanded')==='true';panel.hidden=open;toggle.setAttribute('aria-expanded',String(!open));toggle.setAttribute('aria-label',open?'Open navigation':'Close navigation');});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){const services=document.querySelector<HTMLDetailsElement>('.services-menu');if(services?.open){services.open=false;services.querySelector('summary')?.focus();}}if(e.key==='Escape'&&toggle?.getAttribute('aria-expanded')==='true'){close();toggle.focus();}});
panel?.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));matchMedia('(min-width: 901px)').addEventListener('change',close);
</script></body></html>
