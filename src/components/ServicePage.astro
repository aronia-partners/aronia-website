---
import Base from '../layouts/Base.astro';import CTA from './CTA.astro';
const {title,description,label,headline,lede,aside,challenge,fit,deliverables,steps,next,nextLink,faqs}=Astro.props;
---
<Base title={title} description={description}><section class="page-hero"><div class="wrap"><div class="breadcrumb"><a href="/">Home</a> / Services / {title}</div><div class="hero-columns"><div><span class="eyebrow">{label}</span><h1 set:html={headline}/><p class="lead">{lede}</p><div class="actions"><a href="https://calendly.com/aronia/30min" target="_blank" rel="noopener noreferrer" class="button">Discuss your U.S. business <span aria-hidden="true">↗</span></a></div></div><aside class="hero-aside"><strong>{aside.title}</strong>{aside.text}</aside></div></div></section><section class="section"><div class="wrap two-columns"><div><span class="eyebrow">When this makes sense</span><h2 style="margin-top:25px">{challenge.title}</h2><p>{challenge.text}</p></div><div><h3>Built for your situation</h3><ul class="check-list">{fit.map(x=><li>{x}</li>)}</ul></div></div></section><section class="section sand"><div class="wrap"><div class="section-intro"><span class="eyebrow">The work</span><div><h2>{deliverables.title}</h2><p class="muted">{deliverables.intro}</p></div></div><div class="deliverables">{deliverables.items.map((x,i)=><article class="deliverable"><span class="small-label">0{i+1}</span><h3>{x.title}</h3><p>{x.text}</p></article>)}</div></div></section><section class="section"><div class="wrap"><div class="section-intro"><span class="eyebrow">Working together</span><div><h2>A clear direction.<br/>Shared accountability.</h2></div></div><div class="process">{steps.map(x=><article><h3>{x.title}</h3><p>{x.text}</p></article>)}</div></div></section><section class="section dark"><div class="wrap service-switch"><div><span class="eyebrow">The next decision</span><h3 style="margin-top:25px">{next.title}</h3></div><div><p class="muted">{next.text}</p><a class="text-link" href={nextLink.url}>{nextLink.text} <span aria-hidden="true">↗</span></a></div></div></section><section class="section"><div class="wrap"><div class="section-intro"><span class="eyebrow">A few practical questions</span><h2>Before we begin.</h2></div><div class="faq">{faqs.map(x=><details><summary>{x.q}</summary><p>{x.a}</p></details>)}</div></div></section><CTA/></Base>
